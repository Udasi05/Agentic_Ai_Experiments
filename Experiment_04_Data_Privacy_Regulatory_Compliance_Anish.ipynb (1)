2 Flexibility to choose from 4 unique Death Bene\\ufb01t options \\u2022 Whole of life cover available \\u2022 Acceleration of 50% of Effective sum assured on diagnosis of terminal illness as per the payout plan chosen \\u2022 Inbuilt waiver of premium on terminal illness \\u2022 Special discount for salaried customers on \\ufb01rst year premium \\u2022 Additional \\ufb01rst year premium discount on achieving important life milestones \\u2022 Flexibility to cover spouse under joint life option \\u2022 Option to receive death bene\\ufb01t as lumpsum and/or instalments \\u2022 Premium Break Option - Skip your premiums for\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}],"source":["# ============================================================\n","# STEP 13: PROCESS ALL PRIVACY DOCUMENTS\n","# ============================================================\n","all_chunks=[]\n","for p in DOC_FILES: all_chunks.extend(create_document_chunks(p))\n","print('Documents processed:',len(DOC_FILES)); print('Total chunks:',len(all_chunks))\n","display(pd.DataFrame(all_chunks).head(5))"]},{"cell_type":"code","execution_count":14,"id":"41ba3622","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":485,"referenced_widgets":["44a6cef374a24fdfbc28b328d45e7c6b","bbe11f082db949959069e4cccc7272a4","4a084e79f82b483181b66ed3414f3401","d7da62402eaf4275a9f61d290eeb9a5a","0f2ad9087730422a8be62489b66d26c5","d11d041c4bbd4daab9f1b36e1701d1d7","db9aaa6cdfb5479e8d57443dba001248","fb5b986f7c284ea2aad4a4af9db95f2d","86b4707351954afbae2793fc12d9c350","0b1c1992a7384f819c52a45ce7f72254","84b2baed9ac64c829802401cba1b1aea","f9b12607c0ba4141a33ad32cb74408ac","748b4f0d2ba64d8eb923e9a04f3f6db2","74034ddbc14944cd914accf1d2e4b628","44151d6b20e24f62adc89c1aa333d44d","8da1c5c6e4034243afe5efd589e426fb","6ad3c6fbccaa482bb87d39ab941bee07","1de49592c7db4596b49f50a813318949","f7b101de1d75423d9e9092e9ecde07a3","66549bfa0d2c4486846a8e0