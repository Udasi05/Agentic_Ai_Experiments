_FAILURE\",\n","            \"agent1\": a1,\n","            \"agent2\": None,\n","            \"agent3\": None\n","        }\n","\n","    trace.append(\"Agent 2 — Trial Retrieval\")\n","    a2 = agent2_trial_retrieval(a1)\n","\n","    if a2[\"status\"] != \"SUCCESS\":\n","        trace.append(\"Safe Failure\")\n","        return {\n","            \"trace\": trace,\n","            \"final_status\": \"SAFE_FAILURE\",\n","            \"agent1\": a1,\n","            \"agent2\": a2,\n","            \"agent3\": None\n","        }\n","\n","    trace.append(\"Agent 3 — Eligibility Assessment\")\n","    a3 = agent3_eligibility_assessment(a1, a2)\n","    trace.append(\"Final Result\")\n","\n","    return {\n","        \"trace\": trace,\n","        \"final_status\": \"COMPLETED\",\n","        \"agent1\": a1,\n","        \"agent2\": a2,\n","        \"agent3\": a3\n","    }\n","\n","EXPECTED_WORKFLOW = [\n","    \"Input Guard\",\n","    \"Agent 1 — Patient Information\",\n","    \"Agent 2 — Trial Retrieval\",\n","    \"Agent 3 — Eligibility Assessment\",\n","    \"Final Result\"\n","]\n","\n","WORKFLOW_TESTS = [\n","    (\"WF01\", \"P001\", \"Find clinical trials for my Type 2 diabetes.\"),\n","    (\"WF02\", \"P002\", \"Find clinical trials for my prediabetes.\"),\n","    (\"WF03\", \"P003\", \"Find clinical trials for my Type 2 diabetes.\"),\n","]\n","\n","workflow_rows = []\n","\n","for test_id, patient_id, query in WORKFLOW_TESTS:\n","    result = run_workflow_with_trace(patient_id, query)\n","    actual_trace = result[\"trace\"]\n","    passed = actual_trace == EXPECTED_WORKFLOW\n","\n","    workflow_rows.append({\n","        \"Test ID\": test_id,\n","        \"Expected Sequence\": \" → \".join(EXPECTED_WORKFLOW),\n","        \"Actual Sequence\": \" → \".join(actual_trace),\n","        \"Final Status\": result[\"final_status\"],\n","        \"PASS/FAIL\": \"PASS\" if passed else \"FAIL\"\n","    })\n","\n","workflow_df = pd.DataFrame(workflow_rows)\n","workflow_reliability 